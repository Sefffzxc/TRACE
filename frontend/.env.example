# Where the FastAPI backend is running.
# Copy this file to `.env` (or `.env.local`) and change it if the API is
# somewhere other than the default. `.env` is gitignored.
#
# This is read at BUILD time, not at run time: changing it means rebuilding the
# app, not restarting it. On Render it is set from the API service's hostname
# by render.yaml, and a real environment variable takes priority over this file.
# A bare hostname is accepted — the client adds https:// itself.
VITE_API_URL=http://localhost:8000
