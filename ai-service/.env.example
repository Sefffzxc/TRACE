# Shared secret the monitoring backend must send as X-Service-Token.
# Leave blank for local development to disable the check.
AI_SERVICE_TOKEN=

# Where the joblib bundle lives, relative to the service root.
MODEL_DIR=model

# Stamped onto every prediction so a stored row can be traced to a model build.
MODEL_VERSION=v2-2026-09

# Comma-separated origins, or * . The backend calls this service server-to-server,
# so this only matters if you open /docs from a browser on another origin.
ALLOWED_ORIGINS=*
