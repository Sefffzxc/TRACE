# Copy to .env and adjust. Every value here has a sensible default in
# app/core/config.py, so the file is optional for local development.

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default — no server needed):
DATABASE_URL=sqlite+aiosqlite:///./lbca.db
# PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://lbca:secret@localhost:5432/lbca

# ── Security ──────────────────────────────────────────────────────────────────
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

MAX_LOGIN_ATTEMPTS=5
LOCKOUT_LADDER_MINUTES=5,15,60
MAX_LOCKOUTS=3

# ── Two-factor ────────────────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=10
TWO_FACTOR_DAYS_INTERVAL=90
# Shows the OTP on screen because no mail server is wired up yet.
# Set this to false the moment real email delivery is in place.
DEBUG_OTP=true

# ── Frontend origins allowed to call this API ─────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── AI risk-classification service ────────────────────────────────────────────
# The trained model runs as its own service (see ../ai-service). Start it with:
#   cd ../ai-service && uvicorn main:app --port 8001
AI_ENABLED=true
AI_SERVICE_URL=http://localhost:8001
# Leave blank locally. On Render both services get the same generated value.
AI_SERVICE_TOKEN=
# Saving a record must never wait on the model; if the call takes longer than
# this the rule-based engine fills in and the row is marked as a fallback.
AI_TIMEOUT_SECONDS=6
# Used only for the warm-up ping and the explicit re-score, where waiting for a
# sleeping free-tier service to start is acceptable.
AI_WAKE_TIMEOUT_SECONDS=90
