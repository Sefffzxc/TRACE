    "q1_composite": "0.30 x WW% + 0.50 x PT% + 0.20 x Exam%, at fixed weights",
    "q1_component_gap": "highest minus lowest of the three percentages",
    "grade_level": "7-10"
  },
  "features_excluded": {
    "Weighted scores, initial grade, transmuted term grade": "depend on the weight template and transmutation table, which differ between the training export and the live MATATAG record; the percentages carry the same information in a form that means the same thing under every template",
