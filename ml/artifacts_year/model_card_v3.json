    "later_terms_below_75": 1,
    "subjects": {
      "Filipino": 286
    },
    "grade_levels": {
      "8": 286
    },
    "balancing_applied": "class weights only; no resampling"
  },
  "features_used": [
    "q1_ww_pct",
    "q1_pt_pct",
    "q1_exam_pct",
    "q1_composite",
    "q1_component_gap",
    "grade_level"
