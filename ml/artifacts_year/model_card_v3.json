    "Name": "hashed to a learner key for grouping, never stored",
    "Sex": "excluded as a fairness liability",
    "Subject / Section / School Year": "identifiers; 95% of rows are Filipino"
  },
  "target": "average term grade of the terms after the first < 80",
  "protocol": {
    "splits": "StratifiedGroupKFold by learner, 5 folds x 10 repeats",
    "threshold_selection": "inner 4-fold grouped CV on training learners only; best F1 subject to recall >= 0.8",
    "baselines": "Q1 term grade < 80 (no fitting); Q1 composite below a cut fitted on the training folds"
  },
